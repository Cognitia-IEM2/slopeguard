import math

from core.slope_stability import calculate_fos
from core.pore_pressure import calculate_pore_pressure


def classify_risk(fos, unstable_cutoff=1.00, marginal_cutoff=1.30):
    """
    Classifies slope stability using Factor of Safety.

    FoS < unstable cutoff  -> UNSTABLE
    FoS < marginal cutoff  -> MARGINAL
    Otherwise              -> STABLE
    """

    if fos < unstable_cutoff:
        return "UNSTABLE"

    elif fos < marginal_cutoff:
        return "MARGINAL"

    else:
        return "STABLE"


def calculate_risk_score(
    fos,
    rainfall_mm,
    slope_deg
):
    """
    Creates a 0-100 screening risk score.

    Higher score = higher landslide risk.
    """

    # ---------------------------------------------------------
    # FACTOR OF SAFETY RISK
    # ---------------------------------------------------------

    if fos <= 0:
        fos_risk = 100

    elif fos < 1.0:
        fos_risk = 100

    elif fos < 1.3:
        fos_risk = 70 + (
            (1.3 - fos) / 0.3
        ) * 30

    elif fos < 1.5:
        fos_risk = 40 + (
            (1.5 - fos) / 0.2
        ) * 30

    else:
        fos_risk = max(
            0,
            40 - (fos - 1.5) * 30
        )


    # ---------------------------------------------------------
    # RAINFALL RISK
    # ---------------------------------------------------------

    rainfall_risk = min(
        100,
        (rainfall_mm / 50.0) * 100
    )


    # ---------------------------------------------------------
    # SLOPE RISK
    # ---------------------------------------------------------

    if slope_deg < 15:
        slope_risk = 10

    elif slope_deg < 25:
        slope_risk = 30

    elif slope_deg < 35:
        slope_risk = 60

    elif slope_deg < 45:
        slope_risk = 80

    else:
        slope_risk = 100


    # ---------------------------------------------------------
    # FINAL SCORE
    # ---------------------------------------------------------

    score = (
        0.60 * fos_risk
        + 0.25 * rainfall_risk
        + 0.15 * slope_risk
    )

    return round(
        max(0, min(100, score)),
        2
    )


def generate_terrain_for_segment(index, total_segments):
    """
    Generates demonstration terrain/geotechnical values.

    IMPORTANT:
    These are demo values for the prototype.
    For the final hackathon version, replace these
    with real DEM and soil data.
    """

    # Create changing slope angles along the highway
    slope_deg = 18 + (
        17 *
        math.sin(
            index / max(total_segments - 1, 1)
            * math.pi
        )
    )

    # Small variation in soil properties
    soil_depth = 1.5 + (
        0.5 *
        math.sin(index * 0.8)
    )

    cohesion = 16.0

    friction_angle = 30.0

    unit_weight = 18.5


    return {
        "slope_deg": round(slope_deg, 2),

        "aspect_deg": 180.0,

        "soil_depth_m": round(
            soil_depth,
            2
        ),

        "cohesion_kpa": cohesion,

        "friction_angle_deg":
            friction_angle,

        "unit_weight_kn_m3":
            unit_weight
    }


def interpolate_coordinates(
    start_lat,
    start_lon,
    end_lat,
    end_lon,
    index,
    total_segments
):
    """
    Calculates the location of a highway segment.
    """

    if total_segments <= 1:
        fraction = 0

    else:
        fraction = (
            index /
            (total_segments - 1)
        )

    lat = (
        start_lat
        + (end_lat - start_lat)
        * fraction
    )

    lon = (
        start_lon
        + (end_lon - start_lon)
        * fraction
    )

    return lat, lon


def analyze_route(
    start_lat,
    start_lon,
    end_lat,
    end_lon,
    segments=12,
    rainfall_mm=0.0,
    unstable_cutoff=1.00,
    marginal_cutoff=1.30
):
    """
    Analyses all highway segments.

    Returns a list of dictionaries that can be
    displayed by app.py and dashboard/map.py.
    """

    results = []


    # ---------------------------------------------------------
    # ANALYSE EACH SEGMENT
    # ---------------------------------------------------------

    for i in range(segments):

        segment_number = i + 1


        # -----------------------------------------------------
        # LOCATION
        # -----------------------------------------------------

        lat, lon = interpolate_coordinates(
            start_lat,
            start_lon,
            end_lat,
            end_lon,
            i,
            segments
        )


        # -----------------------------------------------------
        # TERRAIN
        # -----------------------------------------------------

        terrain = generate_terrain_for_segment(
            i,
            segments
        )


        slope_deg = terrain[
            "slope_deg"
        ]

        soil_depth_m = terrain[
            "soil_depth_m"
        ]

        cohesion_kpa = terrain[
            "cohesion_kpa"
        ]

        friction_angle_deg = terrain[
            "friction_angle_deg"
        ]

        unit_weight_kn_m3 = terrain[
            "unit_weight_kn_m3"
        ]


        # -----------------------------------------------------
        # PORE WATER PRESSURE
        # -----------------------------------------------------

        pore = calculate_pore_pressure(

            rainfall_mm,

            soil_depth_m
        )


        pore_pressure_kpa = pore[
            "pore_pressure_kpa"
        ]


        # -----------------------------------------------------
        # FACTOR OF SAFETY
        # -----------------------------------------------------

        fos = calculate_fos(

            slope_deg=slope_deg,

            cohesion_kpa=cohesion_kpa,

            friction_angle_deg=
                friction_angle_deg,

            unit_weight_kn_m3=
                unit_weight_kn_m3,

            soil_depth_m=
                soil_depth_m,

            pore_pressure_kpa=
                pore_pressure_kpa
        )


        # -----------------------------------------------------
        # RISK CLASSIFICATION
        # -----------------------------------------------------

        classification = classify_risk(

            fos,

            unstable_cutoff,

            marginal_cutoff
        )


        # -----------------------------------------------------
        # RISK SCORE
        # -----------------------------------------------------

        risk_score = calculate_risk_score(

            fos,

            rainfall_mm,

            slope_deg
        )


        # -----------------------------------------------------
        # CONFIDENCE
        # -----------------------------------------------------

        confidence = "MEDIUM"

        confidence_reason = (
            "Terrain and soil values "
            "are demonstration estimates."
        )


        # -----------------------------------------------------
        # SEGMENT RESULT
        # -----------------------------------------------------

        result = {

            "rank": 0,

            "segment":
                f"Segment {segment_number}",

            "lat":
                round(lat, 6),

            "lon":
                round(lon, 6),

            "slope_deg":
                round(slope_deg, 2),

            "aspect_deg":
                terrain["aspect_deg"],

            "soil_depth_m":
                round(soil_depth_m, 2),

            "cohesion_kpa":
                round(cohesion_kpa, 2),

            "friction_angle_deg":
                round(
                    friction_angle_deg,
                    2
                ),

            "unit_weight_kn_m3":
                round(
                    unit_weight_kn_m3,
                    2
                ),

            "rainfall_mm":
                round(
                    rainfall_mm,
                    2
                ),

            "pore_pressure_kpa":
                round(
                    pore_pressure_kpa,
                    2
                ),

            "fos":
                round(fos, 2),

            "risk_score":
                round(risk_score, 2),

            "classification":
                classification,

            "confidence":
                confidence,

            "confidence_reason":
                confidence_reason
        }


        results.append(result)


    # ---------------------------------------------------------
    # RANK BY RISK SCORE
    # ---------------------------------------------------------

    results.sort(
        key=lambda x: x["risk_score"],
        reverse=True
    )


    # ---------------------------------------------------------
    # ASSIGN RANK
    # ---------------------------------------------------------

    for rank, result in enumerate(
        results,
        start=1
    ):

        result["rank"] = rank


    return results
